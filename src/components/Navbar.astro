---
import { ThemeToggle } from "@/components/ThemeToggle";
---

<header
    class="flex items-center justify-between whitespace-nowrap px-4 sm:px-6 md:px-10 py-4 sticky top-0 z-50 bg-background-light/80 dark:bg-background-dark/80 backdrop-blur-sm"
>
    <div class="flex items-center gap-2 text-gray-900 dark:text-white">
        <a href="/" class="flex items-center gap-2">
            <img
                class="h-8 w-8 object-contain"
                alt="Minimalist, geometric dinosaur icon with a subtle, futuristic glow"
                src="/images/dino-logo.png"
            />
            <h2 class="text-xl font-bold leading-tight tracking-tight">Lore</h2>
        </a>
    </div>
    <div class="hidden md:flex flex-1 justify-end gap-6 items-center">
        <nav class="flex items-center gap-6">
            <a
                class="text-sm font-medium leading-normal text-gray-700 dark:text-text-dark hover:text-primary transition-colors"
                href="/#features">Features</a
            >
            <a
                class="text-sm font-medium leading-normal text-gray-700 dark:text-text-dark hover:text-primary transition-colors"
                href="/about">About</a
            >
        </nav>
        <ThemeToggle client:load />
        <a
            href="/#waitlist-form"
            class="flex min-w-[84px] max-w-[480px] cursor-pointer items-center justify-center overflow-hidden rounded-full h-10 px-4 bg-primary text-gray-900 text-sm font-semibold leading-normal tracking-[0.015em] hover:bg-opacity-90 transition-opacity"
        >
            <span class="truncate">Join Waitlist</span>
        </a>
    </div>
</header>
