---
import Layout from "../layouts/Layout.astro";
import Navbar from "@/components/Navbar.astro";
import { Footer } from "../components/Footer";
import { Button } from "@/components/ui/button";

const sections = [
    {
        title: "Our Mission",
        content:
            "Creating a sanctuary for stories. We believe that every memory, every laugh, and every lesson deserves to be preserved. Lore is the digital archive that advances humanity's collective memory, ensuring that no story is ever truly lost.",
        imageSide: "left", // Image on Left, Text on Right (Matches Dave Mission)
        image: "/images/mission-graphic.jpg",
        imageAlt: "Lore Dinosaur Mascot",
    },
    {
        title: "Founding Story",
        content:
            "Lore started with a simple question: 'Where do our digital memories go when we're gone?' Three friends—historians and engineers—were fed up with fragmented social media feeds and ephemeral stories. We decided to build a platform designed for permanence, giving families and communities a place to build a legacy that lasts forever.",
        imageSide: "right", // Text on Left, Image on Right (Matches Dave Story)
        image: "/images/founding-story.jpg",
        imageAlt: "Team working together",
    },
];
---

<Layout title="About Us - Lore">
    <div
        class="relative flex min-h-screen w-full flex-col group/design-root overflow-x-hidden"
    >
        <div class="layout-container flex h-full grow flex-col">
            <div
                class="flex flex-1 justify-center py-5 px-4 sm:px-8 md:px-10 lg:px-20 xl:px-40"
            >
                <div
                    class="layout-content-container flex flex-col w-full max-w-6xl flex-1"
                >
                    <Navbar />

                    <main
                        class="flex-1 py-12 md:py-24 flex flex-col gap-24 md:gap-32"
                    >
                        {/* Hero Section */}
                        <div
                            class="text-center max-w-3xl mx-auto flex flex-col gap-6 animate-in fade-in slide-in-from-bottom-8 duration-700"
                        >
                            <h1
                                class="text-5xl md:text-6xl lg:text-7xl font-bold tracking-tighter text-gray-900 dark:text-white"
                            >
                                About <span class="text-primary">Lore</span>
                            </h1>
                            <p
                                class="text-xl md:text-2xl text-primary leading-relaxed"
                            >
                                We are building the future of digital legacy.
                            </p>
                        </div>

                        {/* Zig-Zag Sections using Grid */}
                        <div class="flex flex-col gap-32 md:gap-48 lg:gap-64">
                            {
                                sections.map((section, index) => (
                                    <div class="grid grid-cols-1 md:grid-cols-2 gap-24 items-center">
                                        {/* Text Content */}
                                        <div
                                            class={`flex flex-col gap-8 text-left ${section.imageSide === "left" ? "md:order-last" : "md:order-first"}`}
                                        >
                                            <h2 class="text-3xl md:text-4xl font-bold text-gray-900 dark:text-white tracking-tight">
                                                {section.title}
                                            </h2>
                                            <p class="text-lg text-primary leading-relaxed">
                                                {section.content}
                                            </p>
                                        </div>

                                        {/* Visual/Image Placeholder */}
                                        <div
                                            class={`w-full flex justify-center ${section.imageSide === "left" ? "md:order-first" : "md:order-last"}`}
                                        >
                                            <div class="relative w-64 h-64 shrink-0 rounded-full shadow-2xl overflow-hidden flex items-center justify-center">
                                                <img
                                                    src={section.image}
                                                    alt={section.imageAlt}
                                                    class="w-full h-full object-cover transform transition-transform duration-700 hover:scale-110"
                                                />
                                            </div>
                                        </div>
                                    </div>
                                ))
                            }
                        </div>

                        {/* Bottom CTA */}
                        <div class="flex flex-col items-center gap-12 py-12">
                            <h2
                                class="text-3xl font-bold text-gray-900 dark:text-white"
                            >
                                Ready to leave your mark?
                            </h2>
                            <a
                                href="/#waitlist-form"
                                class="flex min-w-[84px] max-w-[480px] cursor-pointer items-center justify-center overflow-hidden rounded-full h-14 px-8 bg-primary text-gray-900 text-lg font-semibold leading-normal tracking-[0.015em] hover:bg-opacity-90 transition-opacity"
                            >
                                <span class="truncate">Join Waitlist</span>
                            </a>
                        </div>
                    </main>
                    <Footer />
                </div>
            </div>
        </div>
    </div>
</Layout>
